<?xml version="1.0" encoding="utf-8"?>
<!--
  窗口背景 / 启动背景。

  与网页 body 的背景保持完全一致：
      linear-gradient(135deg, #fff0f5 0%, #f0f8ff 100%)

  CSS 的 135deg（指向右下）等价于 android:angle="315"。

  为什么用渐变而不是原来的纯色 #FFFDFBFF：
  沉浸式全屏下，系统仍可能在状态栏 / 挖孔那一带露出窗口背景。
  原来那个近白色就是用户看到的「顶部白条」。换成与页面同款的渐变之后，
  即便真的露出一条，颜色也与页面无缝衔接，看不出来；
  同时它也是 Android 冷启动那一瞬间看到的颜色，避免白闪。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:endColor="#F0F8FF"
        android:startColor="#FFF0F5"
        android:type="linear" />

</shape>
